<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.animepixel.ar">

    <!-- ARCore permissions -->
    <uses-feature android:name="android.hardware.camera.ar" android:required="true" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FLASHLIGHT" />
    
    <!-- Depth API permission -->
    <uses-permission android:name="android.permission.USE_DEPTH_SENSOR" />
    
    <!-- NNAPI permissions -->
    <uses-permission android:name="android.permission.NPU_RUNTIME" />
    
    <!-- Storage for models -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    
    <!-- Sensors -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.SENSOR_PRIVACY" />
    
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.App.NoActionBar"
        android:configChanges="orientation|screenSize|keyboardHidden"
        android:resizeable="none">
        
        <activity
            android:name="com.google.ar.core.AppTheme"
            android:exported="true"
            android:theme="@style/Theme.App.NoActionBar"
            android:screenOrientation="landscape"
            android:launchMode="singleTask"
            android:configChanges="screenSize|smallestScreenSize|orientation|layoutDirection|fontScale|keyboard|keyboardHidden|navigation|screenLayout|uiMode"
            android:resizeable="none">
            
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            
            <meta-data
                android:name="com.google.ar.core"
                android:value="required" />
            <meta-data
                android:name="com.google.ar.core.depth_mode"
                android:value="automatic" />
        </activity>
        
        <!-- TensorFlow Lite Native Libs -->
        <native-library
            android:name="libtensorflowlite_jni.so"
            android:extract="false" />
        <native-library
            android:name="libtensorflowlite_nnapi.so"
            android:extract="false" />
            
    </application>

</manifest>