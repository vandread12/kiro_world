{
  "title": "InventoryItem",
  "description": "Una instancia de item = un documento. PK=PLAYER#<uuid>, SK=ITEM#<item_def>#<instance_id|STACK>. Nunca un array dentro del perfil: un array crece sin cota hacia el limite de 400 KB y cada mutacion reescribiria el documento completo, consumiendo WCU proporcional al tamano total en lugar de al cambio.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "PK", "SK", "entity_type", "entity_version", "version",
    "item_def", "instance_id", "quantity", "stackable", "bound", "state",
    "acquired_at", "acquired_via", "updated_at"
  ],
  "properties": {
    "PK": { "$ref": "_common.json#/$defs/playerPK" },
    "SK": {
      "type": "string",
      "pattern": "^ITEM#[a-z0-9_]{3,48}#([0-9a-f]{8}|STACK)$",
      "description": "Los apilables usan el sufijo literal STACK: un unico documento por definicion de item cuya cantidad se muta con ADD atomico."
    },
    "entity_type": { "const": "ITEM" },
    "entity_version": { "$ref": "_common.json#/$defs/schemaVersion" },
    "version": { "$ref": "_common.json#/$defs/lockVersion" },

    "item_def": { "$ref": "_common.json#/$defs/itemDefId" },
    "instance_id": {
      "oneOf": [
        { "$ref": "_common.json#/$defs/instanceId" },
        { "const": "STACK" }
      ]
    },

    "quantity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9999,
      "description": "Mutado con ADD :delta y ConditionExpression: quantity >= :abs_delta. Nunca con read-modify-write, que es vulnerable a lost update bajo concurrencia."
    },
    "stackable": { "type": "boolean" },
    "bound": {
      "type": "boolean",
      "description": "Si es true el item no es intercambiable. Se evalua en la ConditionExpression del trade."
    },
    "state": { "$ref": "_common.json#/$defs/itemState" },

    "acquired_at": { "$ref": "_common.json#/$defs/epochMillis" },
    "acquired_via": { "$ref": "_common.json#/$defs/acquisitionSource" },
    "updated_at": { "$ref": "_common.json#/$defs/epochMillis" },

    "source_match_id": { "type": "string", "pattern": "^m_[0-9a-f]{6,16}$" },
    "trade_id": {
      "type": "string",
      "pattern": "^t_[0-9a-f]{8,32}$",
      "description": "Presente cuando acquired_via = TRADE. Permite reconstruir la cadena de custodia cruzando con TRADE#<trade_id>."
    },
    "durability": { "type": "integer", "minimum": 0, "maximum": 100 },
    "level": { "type": "integer", "minimum": 1, "maximum": 20 },

    "gsi1pk": {
      "type": "string",
      "pattern": "^ITEMDEF#[a-z0-9_]{3,48}$",
      "description": "GSI1 (esparso, KEYS_ONLY). Solo los documentos ITEM escriben estos atributos, por lo que el indice contiene inventario y nada mas: la amplificacion de escritura queda acotada a las mutaciones de item. Habilita la auditoria inversa item_def -> propietarios, base de la deteccion diaria de duplicados."
    },
    "gsi1sk": { "$ref": "_common.json#/$defs/playerPK" }
  },

  "allOf": [
    {
      "description": "Coherencia entre stackable y la forma de la clave.",
      "if": { "properties": { "stackable": { "const": true } }, "required": ["stackable"] },
      "then": {
        "properties": {
          "instance_id": { "const": "STACK" },
          "bound": { "const": true }
        }
      },
      "else": {
        "properties": {
          "instance_id": { "$ref": "_common.json#/$defs/instanceId" },
          "quantity": { "const": 1 }
        }
      }
    },
    {
      "description": "Un item adquirido via TRADE debe llevar trade_id.",
      "if": { "properties": { "acquired_via": { "const": "TRADE" } }, "required": ["acquired_via"] },
      "then": { "required": ["trade_id"] }
    }
  ],

  "examples": [
    {
      "PK": "PLAYER#7f3a9c21-4e88-4b0a-9d13-6ac2f0e51b77",
      "SK": "ITEM#gauntlet_mk2#a91f4d02",
      "entity_type": "ITEM",
      "entity_version": 1,
      "version": 3,
      "item_def": "gauntlet_mk2",
      "instance_id": "a91f4d02",
      "quantity": 1,
      "stackable": false,
      "bound": false,
      "state": "EQUIPPED",
      "acquired_at": 1788148800000,
      "acquired_via": "MATCH_REWARD",
      "source_match_id": "m_8f21ba",
      "updated_at": 1788220800000,
      "durability": 88,
      "level": 4,
      "gsi1pk": "ITEMDEF#gauntlet_mk2",
      "gsi1sk": "PLAYER#7f3a9c21-4e88-4b0a-9d13-6ac2f0e51b77"
    },
    {
      "PK": "PLAYER#7f3a9c21-4e88-4b0a-9d13-6ac2f0e51b77",
      "SK": "ITEM#potion_medkit#STACK",
      "entity_type": "ITEM",
      "entity_version": 1,
      "version": 17,
      "item_def": "potion_medkit",
      "instance_id": "STACK",
      "quantity": 6,
      "stackable": true,
      "bound": true,
      "state": "OWNED",
      "acquired_at": 1788141600000,
      "acquired_via": "PURCHASE",
      "updated_at": 1788220800000,
      "gsi1pk": "ITEMDEF#potion_medkit",
      "gsi1sk": "PLAYER#7f3a9c21-4e88-4b0a-9d13-6ac2f0e51b77"
    }
  ]
}
