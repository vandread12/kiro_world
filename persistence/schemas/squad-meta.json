{
  "title": "SquadMetadata",
  "description": "Metadatos del escuadron. PK=SQUAD#<uuid>, SK=META. Partition Key propia: anidarlo en el perfil del lider concentraria las escrituras de todos los miembros en su particion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "PK","SK","entity_type","entity_version","version",
    "name","tag","leader","member_count","max_members","join_policy",
    "created_at","updated_at"
  ],
  "properties": {
    "PK": { "$ref": "_common.json#/$defs/squadPK" },
    "SK": { "const": "META" },
    "entity_type": { "const": "SQUAD" },
    "entity_version": { "$ref": "_common.json#/$defs/schemaVersion" },
    "version": { "$ref": "_common.json#/$defs/lockVersion" },

    "name": { "type": "string", "minLength": 3, "maxLength": 24 },
    "tag":  { "type": "string", "pattern": "^[A-Z0-9]{2,5}$" },
    "leader": { "$ref": "_common.json#/$defs/playerPK" },

    "member_count": {
      "type": "integer", "minimum": 1, "maximum": 200,
      "description": "Mutado con ADD +/-1 dentro de la misma transaccion que crea o borra el SquadMember."
    },
    "max_members": { "type": "integer", "minimum": 1, "maximum": 200 },
    "stats_shard_count": {
      "type": "integer", "minimum": 1, "maximum": 50, "default": 10,
      "description": "Numero de shards de escritura de las stats agregadas. Parametro configurable sin rediseno del esquema."
    },

    "join_policy": { "type": "string", "enum": ["OPEN","INVITE_ONLY","CLOSED"] },
    "created_at":  { "$ref": "_common.json#/$defs/epochMillis" },
    "updated_at":  { "$ref": "_common.json#/$defs/epochMillis" }
  },
  "examples": [
    {
      "PK": "SQUAD#1b2c3d4e-5f60-4718-8293-aabbccddeeff",
      "SK": "META",
      "entity_type": "SQUAD",
      "entity_version": 1,
      "version": 11,
      "name": "Rift Wardens",
      "tag": "RFTW",
      "leader": "PLAYER#7f3a9c21-4e88-4b0a-9d13-6ac2f0e51b77",
      "member_count": 24,
      "max_members": 50,
      "stats_shard_count": 10,
      "join_policy": "INVITE_ONLY",
      "created_at": 1788048000000,
      "updated_at": 1788220800000
    }
  ]
}
